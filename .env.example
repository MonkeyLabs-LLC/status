# MonkeyLabs Status Page — Environment Variables
#
# STATUS_DATA_URL — future: URL for live status data
# STATUS_DATA_URL=
#
# SUBSCRIBE_WEBHOOK_URL — future: webhook for email subscriptions (Resend, etc.)
# SUBSCRIBE_WEBHOOK_URL=

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Admin auth
ADMIN_EMAIL=you@example.com
ADMIN_SESSION_SECRET=replace-with-random-64-char-string

# Email (Postmark for admin magic links)
POSTMARK_API_TOKEN=your-postmark-server-api-token
POSTMARK_FROM_EMAIL=status@monkeylabs.gg
POSTMARK_FROM_NAME=MonkeyLabs Status

# Uptime webhook
UPTIME_HOOK_SECRET=replace-with-random-shared-secret
