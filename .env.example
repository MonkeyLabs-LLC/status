# MonkeyLabs Status Page — Environment Variables
#
# Required native Go backend (run the owner locally on port 8788).
STATUS_API_URL=http://localhost:8788
STATUS_API_TOKEN=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STATUS_SUBSCRIBER_LINK_SECRET=REPLACE_ME_SUBSCRIBER_LINK_SECRET

# Admin auth
ADMIN_EMAIL=you@example.com
ADMIN_SESSION_SECRET=replace-with-random-64-char-string

# Astro host email adapter (Resend for Go-authorized admin magic links)
STATUS_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=status@monkeylabs.gg
RESEND_FROM_NAME=MonkeyLabs Status

# Uptime webhook
UPTIME_HOOK_SECRET=replace-with-random-shared-secret
