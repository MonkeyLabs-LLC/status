# Status self-host secrets template — copy to .env on the box, fill real values.
# NEVER commit the real .env. (The status repo .gitignore already ignores .env.)

# --- Cloudflare DNS-01 challenge for traefik Let's Encrypt TLS ---
CF_API_EMAIL=you@example.com
CF_DNS_API_TOKEN=REPLACE_ME_CF_DNS_API_TOKEN

# --- Crunchy status-prod Postgres (same DB as Netlify — no migration) ---
DATABASE_URL=postgres://user:pass@host:5432/postgres?sslmode=require

# --- Ingest / sweep / poll shared secrets ---
# UPTIME_HOOK_SECRET guards /api/v1/sweep, the uptimerobot + status-probe ingest,
# and is what the internal scheduler sends. GRAFANA_HOOK_SECRET guards the
# Grafana ingest. UPTIMEROBOT_API_KEY is the read-only key the internal poller reads.
UPTIME_HOOK_SECRET=REPLACE_ME_LONG_RANDOM_STRING
GRAFANA_HOOK_SECRET=REPLACE_ME_LONG_RANDOM_STRING
UPTIMEROBOT_API_KEY=REPLACE_ME_UPTIMEROBOT_READONLY_KEY

# --- Admin auth + magic-link email ---
ADMIN_EMAIL=admin@monkeylabs.gg
ADMIN_SESSION_SECRET=REPLACE_ME_RANDOM_64_CHAR_STRING
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=status@monkeylabs.gg
RESEND_FROM_NAME=MonkeyLabs Status

# --- Optional internal-mirror wiring (Evolution site-alert); all have fallbacks ---
INTERNAL_SECRET=REPLACE_ME_LONG_RANDOM_STRING
PUBLIC_STATUS_URL=https://status.monkeylabs.gg
PUBLIC_EVOLUTION_URL=https://api.sessions.gg
EVOLUTION_INTERNAL_URL=
