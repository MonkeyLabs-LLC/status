---
import Default from '../layouts/Default.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EmptyState from '../components/EmptyState.astro';
import { getProduct } from '../lib/products';

const product = getProduct('rooms');
if (!product) return Astro.redirect('/');

const scope = (Astro.locals as any).scope as string | null;
const showBreadcrumbs = scope === null;
---
<Default title="Rooms Status">
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    {showBreadcrumbs && (
      <Breadcrumbs items={[
        { label: 'Status', href: '/' },
        { label: 'Rooms' },
      ]} />
    )}

    <EmptyState label="Coming soon" message="Rooms has not launched yet. Status information will appear here when the product goes live." />
  </div>
</Default>
