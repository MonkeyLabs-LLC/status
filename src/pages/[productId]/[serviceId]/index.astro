---
import Default from '../../../layouts/Default.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import UptimeBar from '../../../components/UptimeBar.astro';
import IncidentCard from '../../../components/IncidentCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { getProduct } from '../../../lib/products';
import { getPublicService } from '../../../lib/db-services';
import { getActiveIncidents, getResolvedIncidents } from '../../../lib/db-incidents';
import { statusToState, statusLabel, statusPillClass } from '../../../lib/types';
import { COMPANY_NAME } from '../../../lib/brand';
import type { Product, Service, Incident } from '../../../lib/types';

const { productId, serviceId } = Astro.params;

let product: Product | undefined;
let service: Service | undefined;
let activeIncidents: Incident[] = [];
let resolvedIncidents: Incident[] = [];
try {
  product = productId ? await getProduct(productId) : undefined;
  service = serviceId ? await getPublicService(serviceId) : undefined;
  if (service) {
    activeIncidents = await getActiveIncidents(product?.id, service.id);
    resolvedIncidents = await getResolvedIncidents({ product: product?.id, service: service.id, limit: 10 });
  }
} catch (_e) {
  // DB unreachable
}

if (!product || !service || service.product !== product.id) {
  return new Response('Not found', { status: 404 });
}

const scope = (Astro.locals as any).scope as string | null;
const bodyState = statusToState(service.status);
const pillClass = statusPillClass(service.status);
const label = statusLabel(service.status);

const productHref = scope ? '/' : `/${product.id}`;
const serviceIncidentsHref = scope ? `/${service.id}/incidents` : `/${product.id}/${service.id}/incidents`;
---
<Default title={`${service.name} — ${product.name}`} bodyState={bodyState} productId={product.id}>
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    {scope ? (
      <Breadcrumbs items={[
        { label: product.name, href: '/' },
        { label: service.name },
      ]} />
    ) : (
      <Breadcrumbs items={[
        { label: COMPANY_NAME, href: '/' },
        { label: product.name, href: `/${product.id}` },
        { label: service.name },
      ]} />
    )}

    <div style="margin: 1.5em 0;">
      <h1 style="font-family: var(--sans); font-size: 22px; font-weight: 600; color: var(--text); margin-bottom: 0.3em;">{service.name}</h1>
      <span class={`status-pill ${pillClass}`}>
        <span class="dot"></span>{label}
      </span>
    </div>

    <section style="margin-bottom: 2em;">
      <div class="section-eyebrow">90-day uptime</div>
      <UptimeBar days={service.uptime90d} />
    </section>

    {activeIncidents.length > 0 && (
      <section style="margin-bottom: 1.5em;">
        <div class="section-eyebrow">Active incidents</div>
        {activeIncidents.map((inc) => (
          <IncidentCard incident={inc} showTimeline={false} />
        ))}
      </section>
    )}

    <section>
      <div class="section-eyebrow">Recent incidents</div>
      {resolvedIncidents.length > 0 ? (
        <>
          {resolvedIncidents.map((inc) => (
            <IncidentCard incident={inc} showTimeline={false} />
          ))}
          <div style="text-align: center; padding-top: 1em;">
            <a href={serviceIncidentsHref} class="btn btn-primary">View all incidents</a>
          </div>
        </>
      ) : activeIncidents.length === 0 ? (
        <EmptyState message={`No incidents reported for ${service.name}.`} />
      ) : null}
    </section>
  </div>
</Default>
