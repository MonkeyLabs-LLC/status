---
import Default from '../../../layouts/Default.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import IncidentHistoryItem from '../../../components/IncidentHistoryItem.astro';
import Pagination from '../../../components/Pagination.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { getProduct } from '../../../lib/products';
import { getPublicService } from '../../../lib/db-services';
import { getAllIncidents, countAllIncidents } from '../../../lib/db-incidents';
import { COMPANY_NAME } from '../../../lib/brand';
import type { Service, Incident } from '../../../lib/types';

const { productId, serviceId } = Astro.params;
const product = productId ? getProduct(productId) : undefined;

let service: Service | undefined;
try {
  service = serviceId ? await getPublicService(serviceId) : undefined;
} catch (_e) {
  // DB unreachable
}

if (!product || !service || service.product !== product.id) {
  return new Response('Not found', { status: 404 });
}

const scope = (Astro.locals as any).scope as string | null;

const PAGE_SIZE = 10;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);
const offset = (currentPage - 1) * PAGE_SIZE;

let incidents: Incident[] = [];
let totalPages = 1;
try {
  const total = await countAllIncidents({ product: product.id, service: service.id });
  totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
  incidents = await getAllIncidents({ product: product.id, service: service.id, limit: PAGE_SIZE, offset });
} catch (_e) {
  // DB unreachable — render with empty data
}

const productHref = scope ? '/' : `/${product.id}`;
const serviceHref = scope ? `/${service.id}` : `/${product.id}/${service.id}`;
const basePath = scope ? `/${service.id}/incidents` : `/${product.id}/${service.id}/incidents`;
---
<Default title={`${service.name} Incidents — ${product.name}`} productId={product.id}>
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    {scope ? (
      <Breadcrumbs items={[
        { label: product.name, href: '/' },
        { label: service.name, href: `/${service.id}` },
        { label: 'Incidents' },
      ]} />
    ) : (
      <Breadcrumbs items={[
        { label: COMPANY_NAME, href: '/' },
        { label: product.name, href: `/${product.id}` },
        { label: service.name, href: `/${product.id}/${service.id}` },
        { label: 'Incidents' },
      ]} />
    )}

    <h1 style="font-family: var(--sans); font-size: 22px; font-weight: 600; color: var(--text); margin: 1em 0 0.5em;">{service.name} Incidents</h1>

    {incidents.length > 0 ? (
      <div>
        {incidents.map((inc) => (
          <IncidentHistoryItem incident={inc} />
        ))}
        <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />
      </div>
    ) : (
      <EmptyState message={`No incidents have been reported for ${service.name}.`} />
    )}
  </div>
</Default>
