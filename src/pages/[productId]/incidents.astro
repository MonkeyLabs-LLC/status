---
import Default from '../../layouts/Default.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IncidentHistoryItem from '../../components/IncidentHistoryItem.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getProduct } from '../../lib/products';
import { getIncidents } from '../../lib/incidents';
import { COMPANY_NAME } from '../../lib/brand';

const { productId } = Astro.params;
const product = productId ? getProduct(productId) : undefined;
if (!product) return new Response('Not found', { status: 404 });

const scope = (Astro.locals as any).scope as string | null;

const PAGE_SIZE = 10;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);

const allIncidents = await getIncidents({ product: product.id });
const totalPages = Math.max(1, Math.ceil(allIncidents.length / PAGE_SIZE));
const offset = (currentPage - 1) * PAGE_SIZE;
const incidents = allIncidents.slice(offset, offset + PAGE_SIZE);

const productHref = scope ? '/' : `/${product.id}`;
const basePath = scope ? '/incidents' : `/${product.id}/incidents`;
---
<Default title={`${product.name} Incidents`}>
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    {scope ? (
      <Breadcrumbs items={[
        { label: product.name, href: '/' },
        { label: 'Incidents' },
      ]} />
    ) : (
      <Breadcrumbs items={[
        { label: COMPANY_NAME, href: '/' },
        { label: product.name, href: `/${product.id}` },
        { label: 'Incidents' },
      ]} />
    )}

    <h1 style="font-family: var(--sans); font-size: 22px; font-weight: 600; color: var(--text); margin: 1em 0 0.5em;">Incident History</h1>

    {incidents.length > 0 ? (
      <div>
        {incidents.map((inc) => (
          <IncidentHistoryItem incident={inc} />
        ))}
        <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />
      </div>
    ) : (
      <EmptyState message="No incidents have been reported for this product." />
    )}
  </div>
</Default>
