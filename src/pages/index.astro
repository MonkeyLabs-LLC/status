---
/**
 * Overview page (/).
 *
 * This page is only served for umbrella scope (status.monkeylabs.gg, localhost).
 * Scoped hosts (e.g. status.sessions.gg) have / rewritten to /sessions by middleware,
 * so they never reach this page.
 *
 * Always renders the brand grid overview with StatusOverall hero + BrandCard
 * grid + active incidents across all products.
 */
import Default from '../layouts/Default.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StatusOverall from '../components/StatusOverall.astro';
import IncidentCard from '../components/IncidentCard.astro';
import { getProducts } from '../lib/products';
import { getPublicServices } from '../lib/db-services';
import { getActiveIncidents } from '../lib/db-incidents';
import { worstStatus, statusToState, statusLabel, statusPillClass } from '../lib/types';
import type { Product, Service, Incident } from '../lib/types';

const allProducts = getProducts();

let allServices: Service[] = [];
let activeIncidents: Incident[] = [];
try {
  allServices = await getPublicServices();
  activeIncidents = await getActiveIncidents();
} catch (_e) {
  // DB unreachable — render with empty data
}

const overallStatus = worstStatus(allServices);
const bodyState = statusToState(overallStatus);
---
<Default bodyState={bodyState}>
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    <Breadcrumbs items={[
      { label: 'MonkeyLabs' },
    ]} />

    <StatusOverall status={overallStatus} />

    {activeIncidents.length > 0 && (
      <section style="margin-bottom: 1.5em;">
        <div class="section-eyebrow">Active incidents</div>
        {activeIncidents.map((inc) => (
          <IncidentCard incident={inc} showTimeline={false} />
        ))}
      </section>
    )}

    <section>
      <div class="section-eyebrow">Products</div>
      <div class="brand-grid">
        {allProducts.map((product: Product) => {
          const services = allServices.filter(s => s.product === product.id);
          const status = services.length > 0 ? worstStatus(services) : 'operational' as const;
          const pillClass = statusPillClass(status);
          const label = statusLabel(status);

          const brandColor = `var(--brand-${product.id})`;

          return product.launched ? (
            <a href={`/${product.id}`} class="game-card brand-card" style={`--card-accent: ${brandColor}`}>
              <div class="game-card-top">
                <div class="game-info">
                  <div class="game-name">{product.name}</div>
                  <div class="game-tag">{product.tag}</div>
                </div>
              </div>
              <div class="game-foot">
                <span class={`status-pill ${pillClass}`}>
                  <span class="dot"></span>{label}
                </span>
                <span class="service-count">{services.length} services</span>
              </div>
            </a>
          ) : (
            <div class="game-card brand-card soon" style={`--card-accent: ${brandColor}`}>
              <div class="game-card-top">
                <div class="game-info">
                  <div class="game-name">{product.name}</div>
                  <div class="game-tag">{product.tag}</div>
                </div>
              </div>
              <div class="game-foot">
                <span class="service-count">Coming soon</span>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</Default>
