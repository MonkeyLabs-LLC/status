---
import Default from '../layouts/Default.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IncidentHistoryItem from '../components/IncidentHistoryItem.astro';
import Pagination from '../components/Pagination.astro';
import EmptyState from '../components/EmptyState.astro';
import { getIncidents } from '../lib/incidents';

const scope = (Astro.locals as any).scope as string | null;

const PAGE_SIZE = 10;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);

const allIncidents = getIncidents({ product: scope || undefined });
const totalPages = Math.max(1, Math.ceil(allIncidents.length / PAGE_SIZE));
const offset = (currentPage - 1) * PAGE_SIZE;
const incidents = allIncidents.slice(offset, offset + PAGE_SIZE);
---
<Default title="Incident History">
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    <Breadcrumbs items={[
      ...(scope === null ? [{ label: 'MonkeyLabs', href: '/' }] : []),
      { label: 'Incident History' },
    ]} />

    <h1 style="font-family: var(--sans); font-size: 22px; font-weight: 600; color: var(--text); margin: 1em 0 0.5em;">Incident History</h1>

    {incidents.length > 0 ? (
      <div>
        {incidents.map((inc) => (
          <IncidentHistoryItem incident={inc} />
        ))}
        <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/history" />
      </div>
    ) : (
      <EmptyState message="No incidents have been reported." />
    )}
  </div>
</Default>
