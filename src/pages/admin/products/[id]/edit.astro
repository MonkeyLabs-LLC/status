---
import Admin from '@/layouts/Admin.astro';
import { db } from '@/db';
import { products } from '@/db/schema';
import { archiveProduct, updateProduct } from '@/lib/db-products';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/products');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action')?.toString();

  if (action === 'archive') {
    await archiveProduct(id);
    return Astro.redirect('/admin/products');
  }

  if (action === 'update') {
    const name = form.get('name')?.toString().trim() ?? '';
    const tag = form.get('tag')?.toString().trim() || null;
    const launched = form.get('launched') === 'on';
    const domain = form.get('domain')?.toString().trim() || null;
    const brandColor = form.get('brand_color')?.toString().trim() || null;
    const sortOrder = parseInt(form.get('sort_order')?.toString() ?? '0');

    if (!name) {
      error = 'Name is required.';
    } else {
      await updateProduct(id, { name, tag, launched, domain, brandColor, sortOrder });
      return Astro.redirect('/admin/products');
    }
  }
}

const rows = await db.select().from(products).where(eq(products.id, id));
const product = rows[0];
if (!product) return Astro.redirect('/admin/products');
---
<Admin title={`Edit ${product.name}`}>
  <div class="admin-header">
    <h1>Edit product</h1>
  </div>

  {error && <div style="color:#e05151;font-family:var(--mono);font-size:13px;margin-bottom:1em;">{error}</div>}

  <form method="POST" style="max-width:520px;">
    <input type="hidden" name="_action" value="update">
    <div class="form-group">
      <label class="config-label">id</label>
      <input type="text" class="config-input" value={product.id} disabled style="opacity:0.6;">
      <div class="config-hint">Cannot be changed once created.</div>
    </div>
    <div class="form-group">
      <label class="config-label">name</label>
      <input type="text" name="name" class="config-input" value={product.name} required>
    </div>
    <div class="form-group">
      <label class="config-label">tag</label>
      <input type="text" name="tag" class="config-input" value={product.tag ?? ''}>
    </div>
    <div class="form-group">
      <label class="config-label">domain</label>
      <input type="text" name="domain" class="config-input" value={product.domain ?? ''}>
    </div>
    <div class="form-group">
      <label class="config-label">brand color</label>
      <input type="text" name="brand_color" class="config-input" value={product.brandColor ?? ''} placeholder="#5b9eff">
    </div>
    <div class="form-group">
      <label class="config-label">sort order</label>
      <input type="number" name="sort_order" class="config-input" value={product.sortOrder}>
    </div>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:0.5em;font-size:14px;cursor:pointer;">
        <input type="checkbox" name="launched" checked={product.launched}>
        <span>launched</span>
      </label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a href="/admin/products" class="btn btn-secondary">Cancel</a>
    </div>
  </form>

  <div style="margin-top:3em;padding-top:2em;border-top:1px solid var(--line);">
    <form method="POST">
      <input type="hidden" name="_action" value="archive">
      <button type="submit" class="btn btn-danger" style="font-size:12px;">Archive this product</button>
    </form>
  </div>
</Admin>
