---
/**
 * Add a product — generic form from the products declaration.
 */
import AdminShell from '@/layouts/AdminShell.astro';
import ResourceForm from '@/components/admin/ResourceForm.astro';
import { createProduct, getProduct } from '@/lib/db-products';
import { getResource } from '@/lib/admin/resources';
import { navCounts, propertyOptions } from '@/lib/admin/nav';

const resource = getResource('products')!;
const adminEmail = (Astro.locals as App.Locals).adminEmail ?? 'admin';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = form.get('id')?.toString().trim() ?? '';
  const name = form.get('name')?.toString().trim() ?? '';
  if (!id || !name) {
    error = 'ID and name are required.';
  } else if (!/^[a-z0-9-]+$/.test(id)) {
    error = 'ID must be lowercase alphanumeric and dashes only (e.g. "sessions").';
  } else if (await getProduct(id)) {
    error = `A product with ID "${id}" already exists.`;
  } else {
    await createProduct({
      id, name,
      tag: form.get('tag')?.toString().trim() || null,
      launched: form.get('launched') === 'true',
      domain: form.get('domain')?.toString().trim() || null,
      brandColor: form.get('brandColor')?.toString().trim() || null,
      sortOrder: parseInt(form.get('sortOrder')?.toString() ?? '0') || 0,
    });
    return Astro.redirect('/admin/products');
  }
}

const counts = await navCounts();
const properties = await propertyOptions();
---
<AdminShell title="Add product" active="products" adminEmail={adminEmail} counts={counts} property="all" properties={properties}
  secondaryAction={{ href: '/admin/products', label: '← All products' }}>
  <ResourceForm resource={resource} mode="create" action="/admin/products/new"
    record={{ launched: true }} error={error} cancelHref="/admin/products" />
</AdminShell>
