---
/**
 * Products list — top-level groups. Archive, never delete.
 */
import AdminShell from '@/layouts/AdminShell.astro';
import ResourceList from '@/components/admin/ResourceList.astro';
import { getAllProducts } from '@/lib/db-products';
import { getResource } from '@/lib/admin/resources';
import { navCounts, propertyOptions } from '@/lib/admin/nav';

const resource = getResource('products')!;
const adminEmail = (Astro.locals as App.Locals).adminEmail ?? 'admin';
const property = Astro.url.searchParams.get('property') ?? 'all';
const tab = Astro.url.searchParams.get('tab') ?? 'active';
const rows = await getAllProducts({ archived: tab === 'archived' });
const counts = await navCounts();
const properties = await propertyOptions();
---
<AdminShell title="Products" active="products" adminEmail={adminEmail} counts={counts} property={property} properties={properties}
  primaryAction={{ href: '/admin/products/new', label: '+ Add product' }}>
  <p class="note" style="margin-bottom:16px">{resource.blurb}</p>
  <div class="tabs">
    {resource.tabs!.map((t) => (
      <a class:list={[{ on: t.value === tab }]} href={`/admin/products?tab=${t.value}`}>{t.label}</a>
    ))}
  </div>
  <ResourceList resource={resource} rows={rows}
    hrefFor={(r) => `/admin/products/${r.id}`}
    emptyText={tab === 'archived' ? 'No archived products.' : 'No products yet.'} />
</AdminShell>
