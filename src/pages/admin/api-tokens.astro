---
import Admin from '@/layouts/Admin.astro';
import { createApiToken, revokeApiToken, listApiTokens } from '@/lib/api-tokens';

let newToken: string | null = null;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action')?.toString();

  if (action === 'create') {
    const name = form.get('name')?.toString() ?? '';
    const scope = form.get('scope')?.toString() ?? 'full';
    if (!name) {
      error = 'Token name is required.';
    } else {
      const result = await createApiToken(name, scope);
      newToken = result.token;
    }
  }

  if (action === 'revoke') {
    const tokenId = form.get('token_id')?.toString() ?? '';
    await revokeApiToken(tokenId);
  }
}

const tokens = await listApiTokens();

function formatDate(d: Date | null): string {
  if (!d) return '—';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---
<Admin title="API Tokens">
  <div class="admin-header">
    <h1>API tokens</h1>
  </div>

  {error && <div style="color:#e05151;font-family:var(--mono);font-size:13px;margin-bottom:1em;">{error}</div>}

  {newToken && (
    <div class="status-banner" style="margin-bottom:2em;">
      <div class="banner-head">
        <span class="status-dot" style="width:6px;height:6px;"></span>
        Token created. Copy it now — it won't be shown again.
      </div>
      <div style="margin-top:0.8em;">
        <code style="font-family:var(--mono);font-size:12px;color:var(--text);word-break:break-all;user-select:all;">{newToken}</code>
      </div>
    </div>
  )}

  <!-- Create form -->
  <div style="margin-bottom:2em;padding:16px;border:1px solid var(--line);border-radius:6px;">
    <form method="POST" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
      <input type="hidden" name="_action" value="create">
      <div style="flex:1;min-width:200px;">
        <label class="config-label">name</label>
        <input type="text" name="name" class="config-input" placeholder="e.g. uptime-robot-prod" required>
      </div>
      <div style="flex:0 0 140px;">
        <label class="config-label">scope</label>
        <select name="scope" class="config-input">
          <option value="read">Read only</option>
          <option value="write">Read + Write</option>
          <option value="full">Full access</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" style="height:38px;">Create token</button>
    </form>
  </div>

  <!-- Token list -->
  {tokens.length > 0 ? (
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Scope</th>
          <th>Created</th>
          <th>Last used</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {tokens.map(t => (
          <tr style={t.revokedAt ? 'opacity:0.5;' : ''}>
            <td style="font-weight:600;">{t.name}</td>
            <td><span class="tag">{t.scope}</span></td>
            <td style="font-family:var(--mono);font-size:12px;color:var(--dim);">{formatDate(t.createdAt)}</td>
            <td style="font-family:var(--mono);font-size:12px;color:var(--dim);">{formatDate(t.lastUsedAt)}</td>
            <td>{t.revokedAt ? <span class="tag" style="color:#e05151;border-color:#e05151;">REVOKED</span> : <span class="tag tag-accent">ACTIVE</span>}</td>
            <td>
              {!t.revokedAt && (
                <form method="POST" style="display:inline;">
                  <input type="hidden" name="_action" value="revoke">
                  <input type="hidden" name="token_id" value={t.id}>
                  <button type="submit" class="btn btn-danger" style="padding:4px 10px;font-size:11px;">Revoke</button>
                </form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p style="color:var(--dim);font-size:14px;">No API tokens created yet.</p>
  )}
</Admin>
