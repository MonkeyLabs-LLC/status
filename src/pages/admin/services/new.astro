---
import Admin from '@/layouts/Admin.astro';
import { db } from '@/db';
import { services } from '@/db/schema';
import { nanoid } from 'nanoid';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = form.get('name')?.toString() ?? '';
  const product = form.get('product')?.toString() ?? '';
  const tag = form.get('tag')?.toString() || null;
  const sortOrder = parseInt(form.get('sort_order')?.toString() ?? '0');

  if (!name || !product) {
    error = 'Name and product are required.';
  } else {
    await db.insert(services).values({
      id: nanoid(),
      name,
      product,
      tag,
      status: 'ok',
      sortOrder,
    });
    return Astro.redirect('/admin/services');
  }
}
---
<Admin title="Add Service">
  <div class="admin-header">
    <h1>Add service</h1>
  </div>

  {error && <div style="color:#e05151;font-family:var(--mono);font-size:13px;margin-bottom:1em;">{error}</div>}

  <form method="POST" style="max-width:520px;">
    <div class="form-group">
      <label class="config-label">name</label>
      <input type="text" name="name" class="config-input" placeholder="e.g. Website" required>
    </div>
    <div class="form-group">
      <label class="config-label">product</label>
      <select name="product" class="config-input" required>
        <option value="sessions">sessions</option>
        <option value="core">core (platform)</option>
      </select>
      <div class="config-hint">Which product does this service belong to?</div>
    </div>
    <div class="form-group">
      <label class="config-label">tag</label>
      <input type="text" name="tag" class="config-input" placeholder="e.g. api.sessions.gg">
      <div class="config-hint">Optional domain or identifier shown next to the service name.</div>
    </div>
    <div class="form-group">
      <label class="config-label">sort order</label>
      <input type="number" name="sort_order" class="config-input" value="0">
      <div class="config-hint">Lower numbers appear first.</div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create service</button>
      <a href="/admin/services" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</Admin>
