---
import Admin from '@/layouts/Admin.astro';
import { db } from '@/db';
import { incidents, incidentTimeline } from '@/db/schema';
import { getServices } from '@/lib/db-services';
import { nanoid } from 'nanoid';

const allServices = await getServices({ archived: false });
const products = [...new Set(allServices.map(s => s.product))];

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = form.get('title')?.toString() ?? '';
  const summary = form.get('summary')?.toString() ?? '';
  const severity = form.get('severity')?.toString() ?? 'minor';
  const affects = form.getAll('affects').map(a => a.toString()).filter(Boolean);
  const initialNote = form.get('initial_note')?.toString() ?? '';

  if (!title || !summary || affects.length === 0) {
    error = 'Title, summary, and at least one affected product are required.';
  } else {
    const id = nanoid();
    await db.insert(incidents).values({
      id, title, summary, severity, affects,
      status: 'investigating',
      startedAt: new Date(),
    });
    if (initialNote) {
      await db.insert(incidentTimeline).values({
        id: nanoid(),
        incidentId: id,
        at: new Date(),
        label: 'INVESTIGATING',
        body: initialNote,
      });
    }
    return Astro.redirect(`/admin/incidents/${id}`);
  }
}
---
<Admin title="Declare Incident">
  <div class="admin-header">
    <h1>Declare incident</h1>
  </div>

  {error && <div style="color:#e05151;font-family:var(--mono);font-size:13px;margin-bottom:1em;">{error}</div>}

  <form method="POST" style="max-width:520px;">
    <div class="form-group">
      <label class="config-label">title</label>
      <input type="text" name="title" class="config-input" placeholder="Brief description of the issue" required>
      <div class="config-hint">Write for customers. Plain language, no jargon.</div>
    </div>
    <div class="form-group">
      <label class="config-label">summary</label>
      <textarea name="summary" class="config-input" rows="3" placeholder="What customers are experiencing..." required style="resize:vertical;"></textarea>
    </div>
    <div class="form-group">
      <label class="config-label">severity</label>
      <select name="severity" class="config-input">
        <option value="minor">Minor — cosmetic or low-impact</option>
        <option value="moderate">Moderate — some features affected</option>
        <option value="major">Major — core functionality down</option>
      </select>
    </div>
    <div class="form-group">
      <label class="config-label">affected products</label>
      {products.map(p => (
        <label style="display:flex;align-items:center;gap:0.5em;margin-top:0.4em;font-size:14px;cursor:pointer;">
          <input type="checkbox" name="affects" value={p}>
          {p}
        </label>
      ))}
      {products.length === 0 && <div class="config-hint">No services configured yet. Add services first.</div>}
    </div>
    <div class="form-group">
      <label class="config-label">initial update</label>
      <textarea name="initial_note" class="config-input" rows="2" placeholder="We are investigating reports of..." style="resize:vertical;"></textarea>
      <div class="config-hint">Optional first timeline entry. Customers see this immediately.</div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Declare incident</button>
      <a href="/admin/incidents" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</Admin>
