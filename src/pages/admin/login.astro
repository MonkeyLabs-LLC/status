---
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/components.css';

let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = form.get('email')?.toString() ?? '';

  // Call our own API endpoint
  const res = await fetch(new URL('/api/admin/request-link', Astro.url).toString(), {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email }),
  });

  message = 'If that email is authorized, a login link has been sent. Check your inbox.';
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — MonkeyLabs Status</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap">
</head>
<body class="state-working">
  <div class="page-flow" style="padding-top:120px;">
    <div style="max-width:400px;margin:0 auto;text-align:center;">
      <div style="font-family:var(--mono);font-size:13px;color:var(--dim);margin-bottom:2em;">monkeylabs status · admin</div>
      <h1 style="font-size:22px;font-weight:600;margin:0 0 0.4em;">Sign in</h1>
      <p style="color:var(--dim);font-size:14px;margin-bottom:2em;">Enter your admin email to receive a login link.</p>

      {message ? (
        <div class="status-banner" style="text-align:left;margin-bottom:2em;">
          <div class="banner-head">
            <span class="status-dot" style="width:6px;height:6px;"></span>
            {message}
          </div>
        </div>
      ) : (
        <form method="POST" style="text-align:left;">
          <div class="form-group">
            <label class="config-label">email</label>
            <input type="email" name="email" class="config-input" placeholder="you@example.com" required autofocus>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Send login link</button>
        </form>
      )}
    </div>
  </div>
</body>
</html>
