---
import Default from '../../layouts/Default.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IncidentCard from '../../components/IncidentCard.astro';
import { getIncident } from '../../lib/db-incidents';
import { getProduct } from '../../lib/products';
import type { Incident, Product } from '../../lib/types';

const { id } = Astro.params;

let incident: Incident | undefined;
let product: Product | undefined;
try {
  incident = id ? await getIncident(id) : undefined;
  if (incident) {
    product = await getProduct(incident.product);
  }
} catch (_e) {
  // DB unreachable
}

if (!incident) {
  return new Response('Not found', { status: 404 });
}
const scope = (Astro.locals as any).scope as string | null;

// Determine body state from incident severity
const bodyState = incident.status === 'resolved'
  ? 'working'
  : incident.severity === 'major'
    ? 'outage'
    : incident.severity === 'moderate'
      ? 'degraded'
      : 'working';
---
<Default title={incident.title} bodyState={bodyState}>
  <div class="page-wrap" style="padding-top: 2em; padding-bottom: 3em;">
    <Breadcrumbs items={[
      ...(scope === null ? [{ label: 'MonkeyLabs', href: '/' }] : []),
      ...(product ? [{ label: product.name, href: `/${product.id}` }] : []),
      { label: incident.title },
    ]} />

    <div style="margin-top: 1em;">
      <IncidentCard incident={incident} showTimeline={true} />
    </div>
  </div>
</Default>
