---
import { LEGAL_NAME, PARENT_DOMAIN } from '../lib/brand';
const year = new Date().getFullYear();
const scope = (Astro.locals as any).scope as string | null;
const parentUrl = scope === 'sessions' ? 'https://sessions.gg' : `https://${PARENT_DOMAIN}`;
const parentLabel = scope === 'sessions' ? 'sessions.gg' : PARENT_DOMAIN;
---
<footer class="site-footer">
  <div class="footer-inner">
    <span class="copy">&copy; {year} {LEGAL_NAME}</span>
    <a href={parentUrl}>{parentLabel}</a>
  </div>
</footer>
