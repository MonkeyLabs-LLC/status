---
import type { DayStatus } from '../lib/types';

interface Props {
  days: DayStatus[];
}

const { days } = Astro.props;

// Build date labels for tooltips (90 days ago to today)
const today = new Date();
const labels = days.map((_d, i) => {
  const date = new Date(today);
  date.setDate(date.getDate() - (days.length - 1 - i));
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
});

// Calculate uptime percentage
const okDays = days.filter(d => d === 'ok').length;
const pct = days.length > 0 ? ((okDays / days.length) * 100).toFixed(1) : '100.0';
---
<div class="uptime-bar" role="img" aria-label={`${pct}% uptime over ${days.length} days`}>
  {days.map((status, i) => (
    <div class={`uptime-day ${status}`} data-tooltip={`${labels[i]} — ${status === 'ok' ? 'Operational' : status === 'deg' ? 'Degraded' : status === 'out' ? 'Outage' : status === 'maint' ? 'Maintenance' : 'No data'}`}></div>
  ))}
</div>
<div class="uptime-meta">
  <span>90 days</span>
  <span>{pct}% uptime</span>
</div>
