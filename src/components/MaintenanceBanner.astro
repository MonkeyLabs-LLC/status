---
import type { Maintenance } from '../lib/types';
import { formatDate, formatTime } from '../lib/types';

interface Props {
  maintenance: Maintenance;
}

const { maintenance } = Astro.props;
---
<div class="maintenance-banner">
  <div class="maintenance-title">{maintenance.title}</div>
  <div class="maintenance-meta">
    {formatDate(maintenance.scheduledStart)} at {formatTime(maintenance.scheduledStart)}
    — {formatTime(maintenance.scheduledEnd)}
  </div>
  <p>{maintenance.body}</p>
</div>
