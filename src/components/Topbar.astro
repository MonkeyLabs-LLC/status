---
import { COMPANY_NAME } from '../lib/brand';

const scope = (Astro.locals as any).scope as string | null;

// Detect product context from the URL path on the umbrella domain.
// e.g. /sessions, /sessions/incidents, /bananalabs/foo → 'sessions' or 'bananalabs'
const pathProduct = !scope
  ? Astro.url.pathname.split('/').filter(Boolean)[0] ?? null
  : null;
const effectiveScope = scope || pathProduct;

// History link target:
// - Scoped hostname → /incidents (middleware rewrites to /{scope}/incidents)
// - Umbrella but viewing a product → /{product}/incidents
// - Umbrella root → /history (all-products view)
const historyHref = scope
  ? '/incidents'
  : pathProduct
    ? `/${pathProduct}/incidents`
    : '/history';

// Adapt brand display per scope
let brandName = 'status.' + COMPANY_NAME.toLowerCase() + '.gg';
let brandHref = '/';
let byLine = '';

if (scope === 'sessions') {
  brandName = 'status.sessions.gg';
  byLine = `by ${COMPANY_NAME.toLowerCase()}`;
} else if (scope === 'bananalabs') {
  brandName = 'status.bananalabs.gg';
  byLine = 'infrastructure';
} else if (scope === 'matches') {
  brandName = 'status.matches.gg';
  byLine = `by ${COMPANY_NAME.toLowerCase()}`;
} else if (scope === 'rooms') {
  brandName = 'status.rooms.gg';
  byLine = `by ${COMPANY_NAME.toLowerCase()}`;
}
---
<header class="topbar">
  <div class="topbar-inner">
    <div class="brand-block">
      <a href={brandHref} class="brand">
        <div class="brand-text">
          <span class="brand-name">{brandName}</span>
          {byLine && (
            <div class="brand-meta">
              <span class="by">{byLine}</span>
            </div>
          )}
        </div>
      </a>
    </div>
    <div class="topbar-links">
      <a href={historyHref}>History</a>
      <a href="/feed.xml">Feed</a>
    </div>
  </div>
</header>
