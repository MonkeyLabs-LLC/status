---
import type { Incident } from '../lib/types';
import { severityLabel, severityClass, incidentStatusLabel, relativeTime, formatDate, formatTime } from '../lib/types';

interface Props {
  incident: Incident;
  showTimeline?: boolean;
}

const { incident, showTimeline = true } = Astro.props;
---
<div class="incident-card">
  <div class="incident-header">
    <h3 class="incident-title">
      <a href={`/incident/${incident.id}`}>{incident.title}</a>
    </h3>
    <div class="incident-badges">
      <span class={`badge ${severityClass(incident.severity)}`}>{severityLabel(incident.severity)}</span>
      <span class="badge status-badge">{incidentStatusLabel(incident.status)}</span>
    </div>
  </div>
  <div class="incident-meta">
    Started {relativeTime(incident.started)}
    {incident.resolved && ` — Resolved ${relativeTime(incident.resolved)}`}
  </div>

  {showTimeline && incident.timeline.length > 0 && (
    <div class="timeline">
      {incident.timeline.map((entry) => (
        <div class="timeline-entry">
          <div class="timeline-dot"></div>
          <div class="timeline-status">{incidentStatusLabel(entry.status)}</div>
          <div class="timeline-body">{entry.body}</div>
          <div class="timeline-time">{formatDate(entry.timestamp)} at {formatTime(entry.timestamp)}</div>
        </div>
      ))}
    </div>
  )}
</div>
